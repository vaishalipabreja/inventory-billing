{% extends 'base-template.jinja' %}

{% block content %}
<div class="container my-4">
    <h3 class="text-center mb-4">Invoice Summary</h3>

    <!-- Search Form -->
    <form action="{{ url_for('invoice_history') }}" method="POST" class="mb-4 row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label"><b>Date</b></label>
            <input type="date" name="date" cl ass="form-control">
        </div>

        <div class="col-md-3">
            <label class="form-label"><b>Customer</b></label>
            <input type="text" name="customer" class="form-control" placeholder="Customer Name">
        </div>

        <div class="col-md-3">
            <label class="form-label"><b>Agent</b></label>
            <input type="text" name="agent" class="form-control" placeholder="Agent Name">
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-info w-100">Search</button>
        </div>
    </form>

    {% if not invoices %}
        <div class="text-center mt-5">
            <h5>No Invoice Data Available</h5>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Invoice No</th>
                        <th>Customer</th>
                        <th>Agent</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Balance</th>
                    </tr>
                </thead>

                <tbody>
                {% for invoice in invoices %}
                    <tr>
                        <td>{{ invoice[0] }}</td>
                        <td>{{ invoice[1] }}</td>
                        <td>{{ invoice[2] }}</td>
                        <td>{{ "%.2f"|format(invoice[3]) }}</td>
                        <td>{{ "%.2f"|format(invoice[4]) }}</td>
                        <td>{{ "%.2f"|format(invoice[3] - invoice[4]) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}

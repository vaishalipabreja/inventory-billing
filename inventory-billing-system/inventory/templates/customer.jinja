{% extends 'base-template.jinja' %}
{% block content %}
<div class="container">
    <table class="table">
        <thead>
            <th scope="col">Customer Name</th>
            <th scope="col">Agent Name</th>
            <th scope="col">Total Amount Due</th>
        </thead>
        <tbody>
            {% for customer in customers %}
                <tr>
                    <td>{{ customer[0] }}</td><td>{{ customer[1] }}</td> <td>{{ customer[2] }}</td>
                    <td>
                        <a href="{{ url_for('customer_details', customer_name=customer[0], agent_name=customer[1]) }}" class="btn btn-success">View Details</a><br>
                    </td>
                    <td>
                        <button name="button" type="button" class="btn btn-success" value= "edit" data-toggle="modal" data-target="#edit_{{ customer[0] }}_{{ customer[1] }}" >Edit Name</button><br>
                        <div id="edit_{{ customer[0] }}_{{ customer[1] }}" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="trans_message" aria-hidden="true">
                           <form action="{{ url_for('edit', type='customer') }}" method="post" class="base_form">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-body">
                                        <input name="customer_name" id="input_{{ customer[0] }}" type="text" value="{{customer[0]}}">
                                        <script>
                                            document.getElementById("input_{{ customer[0] }}").oninput = function(){
                                               let all = document.getElementsByClassName("btn btn-primary");
                                                for(let i=0;i<all.length;i++){
                                                    all[i].disabled = false;
                                                }
                                            };
                                        </script>
                                        <input name="agent_name" id="input_{{ customer[1] }}" type="text" value="{{customer[1]}}">
                                        <script>
                                            document.getElementById("input_{{ customer[1] }}").oninput = function(){
                                             let all = document.getElementsByClassName("btn btn-primary");
                                                for(let i=0;i<all.length;i++){
                                                    all[i].disabled = false;
                                                }
                                            };
                                        </script>
                                    </div>
                                    <div class="modal-footer">
                                        <input name="old_customer_name" value="{{ customer[0] }}" hidden aria-hidden="true">
                                        <input name="old_agent_name" value="{{ customer[1] }}" hidden aria-hidden="true">
                                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                        <button type="submit" class="btn btn-primary">Save changes</button>
                                    </div> 
                                </div>
                            </div>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            <!-- Inserting data -->
            <tr>
                <form action = "{{ url_for('customer') }}" method = "POST">
                    <td><input name = "customer_name" placeholder="Customer Name" required autofocus></td>
                    <td><input name = "agent_name" placeholder="Agent Name" required></td>
                    <td><input type= "submit" class="btn btn-info btn-group-toggle" value= "Submit" /><br></td>
                </form>
            </tr>
        </tbody>
    </table>
</div>
<script>
    let close = document.getElementsByClassName("btn btn-default");
    for (let i=0; i<close.length; i++){
        close[i].onclick = function () {
            let clear_fields = document.getElementsByClassName("base_form");
            for(let i=0;i<clear_fields.length;i++){
                clear_fields[i].reset();
            }
            let all = document.getElementsByClassName("btn btn-primary");
            for(let i=0;i<all.length;i++){
                all[i].disabled = false;
            }
        }
    }
</script>
{% endblock %}
{% extends 'base-template.jinja' %}
{% block content %}
.select2-container .select2-selection--single{
    height:34px !important;
}
.select2-container--default .select2-selection--single{
         border: 1px solid #ccc !important; 
     border-radius: 0px !important; 
}
<link href="//maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<!------ Include the above in your HEAD tag ---------->

<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<div class="container">
    <table class="table">
            <tbody>
                <tr>
                <form action = "{{ url_for('invoice') }}" id="invoice" method = "POST">

<div class="container">
	<div class="row">
	        <label>Customer name:</label>
	        <select class="form-control select2" form="invoice" name="customer_name" required>
               {% for customer in customers %}
                <option>{{ customer[0]}}</option>
               {% endfor %}
	        </select>
 	</div>
</div>
<scriptç
    $('.select2').select2();
</script>
                    <br><label for="invoice-items">Product Details:</label><br>
                    <table name="invoice-items" id="invoice-items">
                    </table>
                    <button class="btn btn-info" type="button" id="addProduct">Add Product</button>
                    <br><label for="paid_amount">Amount Paid:</label><br>
                    <tr><input type="number" form="invoice" step="0.01" name = "paid_amount" placeholder="Amount Paid" value=0 required><br></tr>
                    <br><label for="adhat">Additional Charges:</label><br>
                    Adhat: <tr><input type="number" form="invoice" step="0.01" name = "adhat" placeholder="Adhat" value=0 required></tr>
                    Taulai: <tr><input type="number" form="invoice" step="0.01" name = "taulai" placeholder="Taulai" value=0 required></tr>
                    Majdoori: <tr><input type="number" form="invoice" step="0.01" name = "majdoori" placeholder="Majdoori" value=0 required></tr>
                    Packing: <tr><input type="number" form="invoice" step="0.01" name = "packing" placeholder="Packing" value=0 required></tr>
                    Other: <tr><input type="number" form="invoice" step="0.01" name = "other" placeholder="Packing" value=0 required></tr>
                    <br><br><input type= "Submit" class="btn btn-info btn-group-toggle" value= "Submit" /><br>
                </form>
            </tr>
        </tbody>
     </table>
</div>
<script>
        const itemDropdown = document.getElementById('dropdown');
        document.getElementById("addProduct").addEventListener("click", function(event){
            event.preventDefault();
            const table = document.getElementById("invoice-items");
            const row = table.insertRow();
            const cell0 = row.insertCell(0);
            const cell1 = row.insertCell(1);
            const cell2 = row.insertCell(2);
            const cell3 = row.insertCell(3);
            const cell4 = row.insertCell(4);
            const cell5 = row.insertCell(5);
            
            cell0.innerHTML += '<span class="container"><span class="row"><select form="invoice" name="product_name" class="form-control select2" required>{% for product in products %}<option>{{ product[1]}}</option>{% endfor %}</select></span>';
            //cell1.innerHTML += '<input class="container" type="text" list="dropdown" form="invoice" name="product_name" placeholder="Search for an item" oninput=searchProduct(this)>';
            cell2.innerHTML += '<input type="text" form="invoice" name="weight_str" placeholder="Weight(1*24 or 3.5+2.8)" required>';
            cell3.innerHTML += '<input type="number" form="invoice" step="0.01" name="unit_price" placeholder="Rate" required>';
            cell4.innerHTML += '<input type="number" form="invoice" step="0.01" name="less_price" placeholder="Less Weight" value=0 required>';
            cell5.innerHTML += '<button class="btn btn-info" type="button" form="invoice" onclick="removeProduct(this)">Remove Product</button><br>';

        });

        function searchProduct(input) {
            const keyword = input.value.trim();
            console.log(JSON.stringify({keyword : keyword}));
                if (keyword.length > 0) {
                    fetch('/search/product', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({keyword : keyword})
            }).then(response => response.json())
                    .then(data => {
                        var dropdown = $('#dropdown');
                        dropdown.empty();
                        console.log(data)
                        $.each(data, function (index, item) {
                            dropdown.append($('<option></option>').attr('value', item.name));
                        });
                    })
            .catch(error => {
                var dropdown = $('#dropdown');
                dropdown.empty();
            })
                }
        }

        function removeProduct(button) {
            const row = button.parentNode.parentNode;
            row.parentNode.removeChild(row);
        }

        function triggerButtonClick() {
            var buttonElement = document.getElementById('addProduct');
            if (buttonElement) {
                buttonElement.click();
            }
        }
        triggerButtonClick();
    </script>
{% endblock %}
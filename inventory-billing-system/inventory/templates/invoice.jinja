{% extends 'base-template.jinja' %}
{% block content %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>

<div class="container my-4">
    <form id="invoice" action="{{ url_for('invoice') }}" method="POST">
        <h3 class="mb-3">Create Invoice</h3>

<!-- Invoice Date -->
<div class="mb-3">
    <label for="invoice_date" class="form-label"><b>Date:</b></label>
    <input type="date" id="invoice_date" name="invoice_date" class="form-control" 
           value="{{ current_date }}" required>
</div>

<div class="mb-3">
            <label class="form-label"><b>Transport:</b></label>
            <input type="text" class="form-control" name="transportname" placeholder="Transport Name">
        </div>

        <!-- Customer Selection -->
        <div class="mb-3">
            <label for="customer_name" class="form-label"><b>Customer Name:</b></label>
            <select id="customer_name" class="form-control select2" name="customer_name" required>
                {% for customer in customers %}
                    <option>{{ customer[1] }} ({{ customer[2] }})</option>
                {% endfor %}
            </select>
        </div>

        <!-- Product Table -->
        <label for="invoice-items"><b>Product Details:</b></label>
        <table class="table table-bordered" id="invoice-items">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Marka</th>
                    <th>Weight</th>
                    <th>Rate</th>
                    <th>Less Weight</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button type="button" class="btn btn-info mb-3" id="addProduct">Add Product</button>

        <!-- Amount Paid -->
        <div class="mb-3">
            <label for="adjusted_amount" class="form-label"><b>Amount Paid:</b></label>
            <input type="number" step="0.01" class="form-control" name="adjusted_amount" placeholder="Amount Paid" value="0" required>
        </div>

        <!-- Additional Charges (input groups for clear labels) -->
        <div class="mb-3 row g-2">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Packaging</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="packaging" value="0">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Transport</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="transport" value="0">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Mandi</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="mandi" value="0">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Others</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="others" value="0">
                </div>
            </div>
        </div>

        <!-- Totals Display -->
        <div class="card p-3 mb-3">
            <h5 class="mb-2">Invoice Summary</h5>
            <p>Subtotal: <span id="subtotalText">0</span></p>
            <p>Additional Charges: <span id="additionalChargesText">0</span></p>
            <p class="fw-bold">Grand Total: <span id="grandTotalText">0</span></p>
        </div>

        <!-- Comments -->
        <div class="mb-3">
            <label class="form-label"><b>Additional Comments:</b></label>
            <input type="text" class="form-control" name="comment" placeholder="Comment">
        </div>

        <button type="submit" class="btn btn-success">Submit</button>
    </form>
</div>

<script>
$(document).on('click', '.removeProduct', function() {
        $(this).closest('tr').remove();
        updateTotals();
    });

$(document).ready(function() {
    $('.select2').select2({ width: '100%' });

function addProductRow() {
    const products = `
        <option value=""></option>
        {% for product in products %}
        <option value="{{ product[1] }}">{{ product[1] }}</option>
        {% endfor %}
    `;

    const rowHtml = `
        <tr>
            <td>
                <select name="product_name" class="form-control product-select" required>
                    ${products}
                </select>
            </td>
            <td><input type="text" name="marka" class="form-control"></td>
            <td><input type="text" name="weight_str" class="form-control" required></td>
            <td><input type="number" step="0.01" name="unit_price" class="form-control" required></td>
            <td><input type="number" step="0.01" name="less_price" class="form-control" value="0"></td>
            <td><button type="button" class="btn btn-danger removeProduct">Remove</button></td>
        </tr>
    `;

    const $row = $(rowHtml);
    $('#invoice-items tbody').append($row);

    const $select = $row.find('.product-select');

    $select.select2({
        width: '100%',
        placeholder: 'Search product…',
        allowClear: true,
        dropdownParent: $('#invoice')
    });

    // 🔑 WHEN TAB FOCUSES THE FIELD → OPEN + FOCUS SEARCH
    $select.on('select2:open', function () {
        setTimeout(() => {
            document.querySelector('.select2-search__field')?.focus();
        }, 0);
    });
}




    $('#addProduct').click(addProductRow);
    addProductRow(); // initial row
});
function parseExpr(expr) {
    expr = expr.replace(/\s+/g, "").toLowerCase();
    if (!expr) return null;

    // 7x9
    if (expr.includes("x")) {
        const [qty, perBag] = expr.split("x");
        const q = parseInt(qty) || 0;
        const p = parseFloat(perBag) || 0;
        return {
            type: "bag",
            qty: q,
            gross: q * p
        };
    }

    // 65/4 (MUST come before math)
    if (expr.match(/^\d+(\.\d+)?\/\d+$/)) {
        const [gross, qty] = expr.split("/");
        return {
            type: "gross",
            qty: parseInt(qty),
            gross: parseFloat(gross)
        };
    }

    // normal math: 5+3, 1*4
    try {
        const value = Function(`"use strict";return (${expr})`)();
        return {
            type: "normal",
            qty: 1,
            gross: parseFloat(value) || 0
        };
    } catch {
        return null;
    }
}

function updateTotals() {
    let subtotal = 0;

    $('#invoice-items tbody tr').each(function () {
        const expr = $(this).find('input[name="weight_str"]').val();
        const rate = parseFloat($(this).find('input[name="unit_price"]').val()) || 0;
        const less = parseFloat($(this).find('input[name="less_price"]').val()) || 0;

        const data = parseExpr(expr);
        console.log(data);
        if (!data) return;

        const netWeight = Math.max(data.gross - less, 0);

        let amount = 0;
        if (data.type === "bag") {
            amount = data.qty * rate;      // ✔ 7x9
        } else {
            amount = netWeight * rate;     // ✔ 65/4 & normal
        }

        subtotal += amount;
        console.log(subtotal);
    });
    console.log(subtotal);
    $('#subtotalText').text(subtotal.toFixed(2));

    let charges = 0;
    $('.charge-input').each(function () {
        charges += parseFloat($(this).val()) || 0;
    });

    $('#additionalChargesText').text(charges.toFixed(2));
    $('#grandTotalText').text((subtotal + charges).toFixed(2));
}

/* 🔑 IMPORTANT: delegated event */
$(document).on(
    'input',
    'input[name="weight_str"], input[name="unit_price"], input[name="less_price"], .charge-input',
    updateTotals
);

$(document).ready(function () {
    updateTotals();
});

$('#customer_name').select2({
    width: '100%',
    placeholder: 'Search customer…'
});

$(document).on('focus', '.select2-selection', function () {
    const $select = $(this).closest('.select2-container').prev('select');
    if ($select.length && !$select.select2('isOpen')) {
        $select.select2('open');
    }
});


// 🔑 When opened → focus search box
$(document).on('select2:open', function () {
    setTimeout(() => {
        document.querySelector('.select2-search__field')?.focus();
    }, 0);
});

</script>
{% endblock %}

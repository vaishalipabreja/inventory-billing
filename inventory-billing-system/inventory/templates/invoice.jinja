{% extends 'base-template.jinja' %}
{% block content %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>

<div class="container my-4">
    <form id="invoice" action="{{ url_for('invoice') }}" method="POST">
        <h3 class="mb-3">Create Invoice</h3>

        <!-- Customer Selection -->
        <div class="mb-3">
            <label for="customer_name" class="form-label"><b>Customer Name:</b></label>
            <select id="customer_name" class="form-control select2" name="customer_name" required>
                {% for customer in customers %}
                    <option>{{ customer[1] }} ({{ customer[2] }})</option>
                {% endfor %}
            </select>
        </div>

        <!-- Product Table -->
        <label for="invoice-items"><b>Product Details:</b></label>
        <table class="table table-bordered" id="invoice-items">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Weight</th>
                    <th>Rate</th>
                    <th>Less Weight</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button type="button" class="btn btn-info mb-3" id="addProduct">Add Product</button>

        <!-- Amount Paid -->
        <div class="mb-3">
            <label for="adjusted_amount" class="form-label"><b>Amount Paid:</b></label>
            <input type="number" step="0.01" class="form-control" name="adjusted_amount" placeholder="Amount Paid" value="0" required>
        </div>

        <!-- Additional Charges (input groups for clear labels) -->
        <div class="mb-3 row g-2">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Packaging</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="packaging" value="0">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Transport</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="transport" value="0">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Mandi</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="mandi" value="0">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text">Others</span>
                    <input type="number" step="0.01" class="form-control charge-input" name="others" value="0">
                </div>
            </div>
        </div>

        <!-- Totals Display -->
        <div class="card p-3 mb-3">
            <h5 class="mb-2">Invoice Summary</h5>
            <p>Subtotal: <span id="subtotalText">0</span></p>
            <p>Additional Charges: <span id="additionalChargesText">0</span></p>
            <p class="fw-bold">Grand Total: <span id="grandTotalText">0</span></p>
        </div>

        <!-- Comments -->
        <div class="mb-3">
            <label class="form-label"><b>Additional Comments:</b></label>
            <input type="text" class="form-control" name="comment" placeholder="Comment">
        </div>

        <button type="submit" class="btn btn-success">Submit</button>
    </form>
</div>

<script>
$(document).ready(function() {
    $('.select2').select2({ width: '100%' });

    function addProductRow() {
        const products = `{% for product in products %}<option>{{ product[1] }}</option>{% endfor %}`;
        const row = `<tr>
            <td><select name="product_name" class="form-control select2" required>${products}</select></td>
            <td><input type="text" name="weight_str" class="form-control" placeholder="Weight (1*24 or 3.5+2.8)" required></td>
            <td><input type="number" step="0.01" name="unit_price" class="form-control" placeholder="Rate" required></td>
            <td><input type="number" step="0.01" name="less_price" class="form-control" value="0" required></td>
            <td><button type="button" class="btn btn-danger removeProduct">Remove</button></td>
        </tr>`;
        $('#invoice-items tbody').append(row);
        $('.select2').select2({ width: '100%' });
        updateTotals();
    }

    $('#addProduct').click(addProductRow);

    $(document).on('click', '.removeProduct', function() {
        $(this).closest('tr').remove();
        updateTotals();
    });

    function parseWeight(weightStr) {
        try { return eval(weightStr) || 0; } 
        catch { return 0; }
    }

    function updateTotals() {
        let subtotal = 0;

        $('#invoice-items tbody tr').each(function() {
            const weight = parseWeight($(this).find('input[name="weight_str"]').val());
            const rate = parseFloat($(this).find('input[name="unit_price"]').val()) || 0;
            const less = parseFloat($(this).find('input[name="less_price"]').val()) || 0;
            const netWeight = Math.max(weight - less, 0);

            subtotal += netWeight * rate;
        });

        $('#subtotalText').text(subtotal.toFixed(2));

        // Sum additional charges
        let additionalCharges = 0;
        $('.charge-input').each(function() {
            additionalCharges += parseFloat($(this).val()) || 0;
        });
        $('#additionalChargesText').text(additionalCharges.toFixed(2));

        const grandTotal = subtotal + additionalCharges;
        $('#grandTotalText').text(grandTotal.toFixed(2));
    }

    $(document).on('input', 'input[name="weight_str"], input[name="unit_price"], input[name="less_price"], .charge-input', updateTotals);

    addProductRow(); // initial row
});
</script>
{% endblock %}

{% extends 'base-template.jinja' %}
{% block content %}
<div class="container">
    <h2>Customer Details</h2>
    <p><strong>Customer Name:</strong> {{ customer_details.customer_name }}</p>
    <p><strong>Agent Name:</strong> {{ customer_details.agent_name }}</p>

    <div class="row">
        <div class="col-md-6">
            <h3>Invoices</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Invoice ID</th>
                        <th>Total Amount</th>
                        <th>Paid Amount</th>
                        <th>Invoice Time</th>
                    </tr>
                </thead>
                <tbody>
                    {% for invoice in customer_details.invoices %}
                        <tr>
                            <td>{{ invoice[0] }}</td>
                            <td>{{ invoice[1] }}</td>
                            <td>{{ invoice[2] }}</td>
                            <td>{{ invoice[3] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h3>Payments</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Payment Amount</th>
                        <th>Payment Time</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in customer_details.payments %}
                        <tr>
                            <td>{{ payment[1] }}</td>
                            <td>{{ payment[2] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="record-payment-button-container">
        <button name="button" type="button" class="btn btn-success" data-toggle="modal" data-target="#recordPaymentModal">
            Record Payment
        </button>
    </div>

    <div class="modal fade" id="recordPaymentModal" tabindex="1" role="dialog" aria-labelledby="recordPaymentModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="recordPaymentModalLabel">Record Payment</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="recordPaymentForm" action="{{ url_for('record') }}" method="post">
                        <div class="form-group">
                            <label for="discount">Discount:</label>
                            <input type="number" class="form-control" id="discount" name="discount" placeholder="Discount" value="0">
                        </div>
                        <div class="form-group">
                            <label for="amount">Amount Paid:</label>
                            <input type="number" class="form-control" id="amount" name="amount" placeholder="Amount Paid" value="0">
                        </div>
                        <input type="hidden" name="customer_name" value="{{ customer_details.customer_name }}">
                        <input type="hidden" name="agent_name" value="{{ customer_details.agent_name }}">
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Optional: You can remove this script if you are already including Bootstrap and jQuery in your project.
    document.addEventListener('DOMContentLoaded', function () {
        var myModal = new bootstrap.Modal(document.getElementById('recordPaymentModal'));
    });

    // Optional: You can remove this script if you are already including jQuery in your project.
    function recordPayment() {
        $('#recordPaymentForm').submit();
    }
</script>
{% endblock %}

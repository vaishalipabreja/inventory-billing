{% extends 'base-template.jinja' %}

{% block content %}
<div class="container">

    <!-- Header + Record Payment Button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Customer Details</h2>
            <small class="text-muted">
                {{ customer_details.customer_name }} ({{ customer_details.agent_name }})
            </small>
        </div>
        <button class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#recordPaymentModal">
            Record Payment
        </button>
    </div>

    <div class="row">
        <!-- Invoices -->
        <div class="col-md-6">
            <h4>Invoices</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Remaining</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for invoice in customer_details.invoices %}
                        <tr>
                            <td>{{ invoice[0] }}</td>
                            <td>{{ invoice[1] }}</td>
                            <td>{{ invoice[2] }}</td>
                            <td>{{ invoice[1] - invoice[2] - (invoice[3] if invoice|length > 4 else 0) }}</td>
                            <td>{{ invoice[3] }}</td>
                            <td>
                            <form action="{{ url_for('delete_invoice', invoice_id=invoice[0]) }}"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this invoice?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No invoices found
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Payments -->
        <div class="col-md-6">
            <h4>Payments</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Amount Paid</th>
                            <th>Discount</th>
                            <th>Payment Mode</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payment in customer_details.payments %}
                        <tr>
                            <td>{{ payment[1] }}</td>
                            <td>{{ payment[2] }}</td>
                            <td>{{ payment[3] }}</td>
                            <td>{{ payment[4] }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                No payments recorded
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Record Payment Modal -->
<div class="modal fade" id="recordPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form action="{{ url_for('record') }}" method="post" class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Record Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Discount</label>
                    <input type="number" class="form-control" name="discount" value="0" min="0" step="0.01">
                </div>

                <div class="mb-3">
                    <label class="form-label">Amount Paid</label>
                    <input type="number" class="form-control" name="amount" value="0" min="0" step="0.01">
                </div>

                <div class="mb-3">
                    <label class="form-label">Payment Mode</label>
                    <input type="text" class="form-control" name="payment_mode" value="Cash" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Payment Date</label>
                    <input type="date" class="form-control" name="payment_date" value="{{ current_date }}">
                </div>

                <input type="hidden" name="customer_name" value="{{ customer_details.customer_name }}">
                <input type="hidden" name="agent_name" value="{{ customer_details.agent_name }}">
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    Save Payment
                </button>
            </div>

        </form>
    </div>
</div>

{% endblock %}
